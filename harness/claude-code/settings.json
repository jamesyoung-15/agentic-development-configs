{
  "$comment": "Merge into a project's .claude/settings.json. Adjust the hook path to your checkout.",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(glab mr view:*)",
      "Bash(glab mr diff:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dev/agentic-development/harness/claude-code/hooks/style-check-hook.sh"
          }
        ]
      }
    ]
  }
}
